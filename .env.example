# ==============================================================================
# BUBBLE BOOM E-COMMERCE CONFIGURATION (.env.example)
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, SSR)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Cashfree Payments (v2023-08-01 API)
# ------------------------------------------------------------------------------
# For Sandbox: https://sandbox.cashfree.com/pg
# For Production: https://api.cashfree.com/pg
CASHFREE_API_URL=https://sandbox.cashfree.com/pg
CASHFREE_APP_ID=TEST_your_app_id
CASHFREE_SECRET_KEY=TEST_your_secret_key
CASHFREE_ENVIRONMENT=SANDBOX
# Webhook signature verification secret from Cashfree Dashboard -> Developers -> Webhooks
CASHFREE_WEBHOOK_SECRET=your_webhook_secret_key
NEXT_PUBLIC_CASHFREE_APP_ID=TEST_your_app_id

# ------------------------------------------------------------------------------
# 3. Cloudinary (Product Photography)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=bubbleboom
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. Resend (Transactional Order & Dispatch Emails)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="BUBBLE BOOM <orders@bubbleboom.in>"

# ------------------------------------------------------------------------------
# 5. Storefront & Admin Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="BUBBLE BOOM"
# Fallback email granted immediate Admin Terminal access
ADMIN_EMAIL=admin@bubbleboom.in

# ------------------------------------------------------------------------------
# 6. Analytics & Observability (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX
