# ==============================================================================
# BUBBLE BOOM E-COMMERCE CONFIGURATION (.env.example)
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, SSR)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Cashfree Payments (v2023-08-01 PG API)
# ------------------------------------------------------------------------------
# SERVER-ONLY CREDENTIALS (NEVER prefix with NEXT_PUBLIC_):
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# ENVIRONMENT & SDK MODE ('production' or 'sandbox'):
# Used by frontend @cashfreepayments/cashfree-js browser SDK:
NEXT_PUBLIC_CASHFREE_MODE=production
# Used by server-side backend API calls:
CASHFREE_ENVIRONMENT=production

# OPTIONAL: Explicit PG endpoint override
# Sandbox: https://sandbox.cashfree.com/pg | Production: https://api.cashfree.com/pg
CASHFREE_API_URL=https://api.cashfree.com/pg

# Webhook signature verification secret from Cashfree Dashboard -> Developers -> Webhooks
CASHFREE_WEBHOOK_SECRET=your_webhook_secret_key

# ------------------------------------------------------------------------------
# 3. Cloudinary (Product Photography)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=bubbleboom
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. Resend (Transactional Order & Dispatch Emails)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="BUBBLE BOOM <orders@bubbleboom.in>"

# ------------------------------------------------------------------------------
# 5. Storefront & Admin Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="BUBBLE BOOM"
# Fallback email granted immediate Admin Terminal access
ADMIN_EMAIL=admin@bubbleboom.in

# ------------------------------------------------------------------------------
# 6. Analytics & Observability (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX
